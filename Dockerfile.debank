# ============= Compilation Stage ================
FROM golang:1.25.8-trixie AS builder

ARG ACCESS_TOKEN

RUN git config --global url."https://x-access-token:${ACCESS_TOKEN}@github.com".insteadOf "https://github.com"

RUN mkdir -p $GOPATH/src/github.com/ava-labs
WORKDIR $GOPATH/src/github.com/ava-labs

# Copy avalanchego-x repo into desired location. The embedded coreth
# (graft/coreth) already has the required replace directives in its go.mod
# pointing at Chaintable/libevm and the pinned go-ipa.
COPY . avalanchego

WORKDIR $GOPATH/src/github.com/ava-labs/avalanchego

RUN GOSUMDB=off GOPRIVATE=github.com/Chaintable/* go mod download

# Build the AvalancheGo binary.
RUN ./scripts/build.sh

# Create the plugins directory in the standard location so the build directory
# will be recognized as valid.
RUN mkdir -p build/plugins

# Download the pre-built avaxctl CLI to builder
RUN wget https://debank-build-artifacts.s3.ap-northeast-1.amazonaws.com/downloads/avax/avaxctl -O build/avaxctl
RUN chmod +x build/avaxctl

# ============= Cleanup Stage ================
FROM ubuntu:24.04

RUN apt-get update && apt-get install ca-certificates -y && update-ca-certificates

# Maintain compatibility with previous images
RUN mkdir -p /avalanchego/build
WORKDIR /avalanchego/build

# Copy the executables into the container
COPY --from=builder /go/src/github.com/ava-labs/avalanchego/build .

CMD [ "./avalanchego" ]
